{
  "id": "local.cqcvc",
  "name": "重庆城市职业学院超星教务适配",
  "version": "1.0.7",
  "apiVersion": 3,
  "kind": "independent",
  "capabilities": [
    "auth.start",
    "auth.resume",
    "auth.refreshCaptcha",
    "auth.validate",
    "study.terms",
    "study.schedule",
    "study.calendar",
    "study.grades",
    "study.exams"
  ],
  "network": [
    {
      "origin": "https://jw.cqcvc.edu.cn",
      "pathPrefix": "/admin/login",
      "methods": ["POST"],
      "purposes": ["auth"]
    },
    {
      "origin": "https://jw.cqcvc.edu.cn",
      "pathPrefix": "/admin",
      "methods": ["GET", "POST"],
      "purposes": ["query", "auth"]
    },
    {
      "origin": "https://jw.cqcvc.edu.cn",
      "pathPrefix": "/login",
      "methods": ["GET"],
      "purposes": ["auth"]
    }
  ],
  "school": {
    "id": "local.cqcvc",
    "name": "重庆城市职业学院",
    "domain": "jw.cqcvc.edu.cn",
    "protocol": "https",
    "basePath": "/",
    "academicSystem": "auto",
    "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36 Edg/154.0.0.0"
  },
  "files": {},
  "entry": "index.js",
  "description": "重庆城市职业学院（jw.cqcvc.edu.cn）超星综合教学管理系统独立适配",
  "releaseNotes": "最新版本在Github，插件中心不一定是最新版本",
  "features": [
    "超星教务登录（RSA 加密）",
    "学期列表与当前学期",
    "周课表（含断周课程周次）",
    "上课作息时间表",
    "成绩与绩点查询",
    "考试安排查询"
  ]
}
